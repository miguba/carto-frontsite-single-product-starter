---
import Layout from '@/layouts/DefaultLayout/index.astro';
import {
  getCachedCommerceConfig,
  getOrder,
  mediaUrl,
  type Order,
} from '@/lib/commerce';
import {
  getOrderSuccessContent,
  renderTextTemplate,
} from '@/lib/remote-content';
import orderSuccessContentSource from '@/content/blocks/order-success-content.md?raw';

export const prerender = false;

const orderNo = Astro.params.orderNo || '';
let order: Order | null = null;
let mediaBaseUrl = '';
let successHeading = '';
let successNoticeTemplate = '';
let error = '';
const refreshCache = Astro.url.searchParams.get('___refresh___') === '1';

try {
  const [loadedOrder, config, orderSuccessContent] = await Promise.all([
    orderNo ? getOrder(orderNo) : Promise.resolve(null),
    getCachedCommerceConfig({ refresh: refreshCache }),
    getOrderSuccessContent({ refresh: refreshCache }),
  ]);
  order = loadedOrder;
  mediaBaseUrl = config.mediaBaseUrl;
  successHeading = orderSuccessContent.successHeading;
  successNoticeTemplate = orderSuccessContent.successNotice;
  if (!order) error = 'Missing order number.';
} catch (caught) {
  error =
    caught instanceof Error ? caught.message : 'Unable to load this order.';
}

const paid = order?.paymentStatus === 'paid';
const authorized = order?.paymentStatus === 'authorized';
const orderConfirmed = paid || authorized;
const statusLabel = order ? capitalize(order.status) : '';
const paymentLabel = order ? capitalize(order.paymentStatus) : '';
const customerName = order
  ? `${order.customer.firstName} ${order.customer.lastName}`.trim()
  : '';
const money = (amount: number, currency = order?.currency || 'USD') =>
  new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(
    (amount || 0) / 100,
  );

function capitalize(value: string) {
  return value.charAt(0).toUpperCase() + value.slice(1);
}

const successNotice = order
  ? renderTextTemplate(successNoticeTemplate, {
      orderNo: order.orderNo,
      customerName,
      customerEmail: order.customer.email,
      total: money(order.totalAmount),
      itemCount: order.itemCount,
      paymentStatus: paymentLabel,
      orderStatus: statusLabel,
    })
  : '';
const resultNotice = successNotice;
---

<Layout
  seoInfo={{
    title: order ? `Order ${order.orderNo}` : 'Order status',
  }}
  noindex
>
  <script
    is:inline
    type="application/yaml"
    data-carto-block-source="order-success-content"
    data-carto-block-type="block"
    set:text={orderSuccessContentSource}
  />
  {
    order ? (
      <section class="wrap bg-gray-50/50 py-8 md:py-14">
        <div class="mx-auto grid max-w-4xl gap-4 md:gap-5">
          <header
            data-carto-block="order-success-content"
            data-carto-block-type="block"
            class:list={[
              'grid gap-8 rounded-2xl border bg-white px-6 py-7 shadow-sm md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:px-8 md:py-9',
              orderConfirmed ? 'border-green-200' : 'border-gray-200',
            ]}
          >
            <div class="max-w-2xl">
              <div
                class:list={[
                  'mb-5 grid h-11 w-11 place-items-center rounded-full text-xl font-bold',
                  orderConfirmed
                    ? 'bg-green-100 text-green-700'
                    : 'bg-gray-100 text-gray-700',
                ]}
              >
                {orderConfirmed ? '✓' : '!'}
              </div>
              <p
                class:list={[
                  'mb-2 text-xs font-bold uppercase tracking-[0.14em]',
                  orderConfirmed ? 'text-green-700' : 'text-gray-600',
                ]}
              >
                {orderConfirmed ? 'Payment complete' : 'Order status'}
              </p>
              <h1 class="mb-3 text-3xl font-bold leading-tight text-gray-950 md:text-4xl">
                {orderConfirmed
                  ? successHeading
                  : `Payment status: ${paymentLabel}`}
              </h1>
              <p class="max-w-xl text-base leading-7 text-gray-600">
                {resultNotice}
              </p>
              <div class="mt-6 flex flex-wrap gap-3">
                <a
                  class="rounded-lg bg-primary px-5 py-3 font-bold text-primary-foreground shadow-sm"
                  href="/"
                >
                  Continue shopping
                </a>
                <a
                  class="rounded-lg border border-gray-300 bg-white px-5 py-3 font-bold text-gray-800"
                  href="/contact-us"
                >
                  Contact support
                </a>
              </div>
            </div>
            <div class="border-t border-gray-200 pt-5 md:min-w-40 md:border-l md:border-t-0 md:pl-8 md:pt-0 md:text-right">
              <div class="text-sm font-medium text-gray-500">Order total</div>
              <div class="mt-1 text-3xl font-bold text-gray-950">
                {money(order.totalAmount)}
              </div>
              <div class="mt-1 text-sm text-gray-500">
                {order.itemCount} {order.itemCount === 1 ? 'item' : 'items'} ·{' '}
                {paymentLabel}
              </div>
            </div>
          </header>

          <div class="grid overflow-hidden rounded-xl border border-gray-200 bg-white md:grid-cols-3">
            {[
              authorized
                ? ['Order placed', 'Payment authorized', true]
                : ['Paid', 'Payment captured', paid],
              [
                'Processing',
                'Preparing digital delivery',
                order.status === 'processing' || order.status === 'done',
              ],
              ['Done', 'Order fulfilled', order.status === 'done'],
            ].map(([label, note, complete]) => (
              <div class="flex gap-3 border-b p-5 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0">
                <span
                  class:list={[
                    'mt-0.5 grid h-5 w-5 place-items-center rounded-full border text-xs',
                    complete
                      ? 'border-green-600 bg-green-600 text-white'
                      : 'border-gray-300',
                  ]}
                >
                  {complete ? '✓' : ''}
                </span>
                <div>
                  <strong>{label}</strong>
                  <div class="text-sm text-gray-500">{note}</div>
                </div>
              </div>
            ))}
          </div>

          <div class="grid gap-8 rounded-xl border border-gray-200 bg-white p-6 md:grid-cols-[1.2fr_0.8fr] md:p-8">
            <div>
              <div class="mb-4 flex items-center justify-between">
                <div>
                  <>
                    <p class="text-xs font-bold uppercase tracking-wide text-primary">
                      Receipt
                    </p>
                    <h2 class="text-2xl font-bold">Order summary</h2>
                  </>
                </div>
                <span class="rounded-full border px-3 py-1 text-xs font-bold uppercase">
                  {paymentLabel}
                </span>
              </div>
              <dl class="divide-y border-y">
                <div class="flex justify-between py-3">
                  <>
                    <dt>Status</dt>
                    <dd>{statusLabel}</dd>
                  </>
                </div>
                <div class="flex justify-between py-3">
                  <>
                    <dt>Items</dt>
                    <dd>{order.itemCount}</dd>
                  </>
                </div>
                <div class="flex justify-between py-3">
                  <>
                    <dt>Subtotal</dt>
                    <dd>{money(order.subtotalAmount)}</dd>
                  </>
                </div>
                <div class="flex justify-between py-3">
                  <>
                    <dt>Shipping</dt>
                    <dd>{money(order.shippingAmount)}</dd>
                  </>
                </div>
                <div class="flex justify-between py-3">
                  <>
                    <dt>Tax</dt>
                    <dd>{money(order.taxAmount)}</dd>
                  </>
                </div>
                <div class="flex justify-between py-4 text-lg font-bold">
                  <>
                    <dt>Total</dt>
                    <dd>{money(order.totalAmount)}</dd>
                  </>
                </div>
              </dl>
            </div>
            <div class="md:border-l md:pl-6">
              <p class="text-xs font-bold uppercase tracking-wide text-primary">
                Delivery details
              </p>
              <h2 class="mb-4 text-2xl font-bold">Customer</h2>
              <dl class="divide-y border-y">
                <div class="flex justify-between gap-4 py-3">
                  <>
                    <dt>Name</dt>
                    <dd class="text-right">{customerName}</dd>
                  </>
                </div>
                <div class="flex justify-between gap-4 py-3">
                  <>
                    <dt>Email</dt>
                    <dd class="break-all text-right">{order.customer.email}</dd>
                  </>
                </div>
                <div class="flex justify-between gap-4 py-3">
                  <>
                    <dt>Address</dt>
                    <dd class="text-right">
                      {order.shippingAddress.address1}
                      {order.shippingAddress.address2
                        ? `, ${order.shippingAddress.address2}`
                        : ''}
                      <br />
                      {order.shippingAddress.city},{' '}
                      {order.shippingAddress.state}{' '}
                      {order.shippingAddress.postalCode}
                      <br />
                      {order.shippingAddress.country}
                    </dd>
                  </>
                </div>
              </dl>
            </div>
          </div>

          <div class="rounded-xl border border-gray-200 bg-white p-6 md:p-8">
            <div class="mb-4 flex items-center justify-between">
              <>
                <h2 class="text-2xl font-bold">Items</h2>
                <span class="text-sm text-gray-500">
                  {order.items.length} lines
                </span>
              </>
            </div>
            <div class="divide-y border-y">
              {order.items.map((item) => {
                const imageUrl = mediaUrl(item.image, mediaBaseUrl);
                return (
                  <article class="grid gap-4 py-5 sm:grid-cols-[80px_1fr_auto] sm:items-center">
                    <div class="grid h-20 w-20 place-items-center overflow-hidden rounded bg-gray-100">
                      {imageUrl ? (
                        <img
                          class="h-full w-full object-contain"
                          src={imageUrl}
                          alt={item.productTitle}
                        />
                      ) : (
                        <span class="font-bold text-primary">3D</span>
                      )}
                    </div>
                    <div>
                      <strong class="text-lg">{item.productTitle}</strong>
                      <div class="text-sm text-gray-500">
                        {item.sku} × {item.quantity}
                      </div>
                    </div>
                    <div class="font-bold sm:text-right">
                      {money(item.lineTotal)}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    ) : (
      <section class="wrap grid min-h-[60vh] place-items-center py-12">
        <div class="max-w-xl rounded-xl border bg-white p-8 text-center shadow-sm">
          <p class="mb-2 text-sm font-bold uppercase tracking-wide text-primary">
            Order unavailable
          </p>
          <h1 class="mb-4 text-4xl font-bold">We could not load this order.</h1>
          {import.meta.env.DEV && <p class="mb-5 text-gray-500">{error}</p>}
          <a
            class="inline-flex rounded bg-primary px-6 py-3 font-bold text-primary-foreground"
            href="/"
          >
            Return to store
          </a>
        </div>
      </section>
    )
  }
</Layout>
